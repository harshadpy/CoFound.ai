# =====================================================================
# CoFound.ai — Environment Configuration Template
# =====================================================================

# 1. AI & Search API Keys
OPENAI_API_KEY="sk-..."
TAVILY_API_KEY="tvly-..."

# 2. LangSmith Observability (Optional)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="lsv2_pt_..."
LANGSMITH_PROJECT="cofound"

# 3. Supabase Cloud Project (Auth & Cloud Database)
# Find in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# SUPABASE_JWT_SECRET="your-jwt-secret"  # Optional, for token decoding

# 4. Centralized Access & Billing Policy
# Set BILLING_ENABLED=false to bypass subscription paywalls and make all features 100% free
BILLING_ENABLED=false
# AI Swarm protection limits per session
GUEST_ANALYSIS_LIMIT=5
USER_ANALYSIS_LIMIT=50
